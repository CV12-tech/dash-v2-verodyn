# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

# Base URL where NextAuth issues callbacks. In production, set this to the public URL.
NEXTAUTH_URL=http://localhost:3000

# Strong secret for JWT signing. Generate with: openssl rand -base64 48
# Must be at least 32 characters.
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-48-output-please-rotate

# Optional: database connection string once you swap the in-memory user store.
# DATABASE_URL=postgresql://user:pass@localhost:5432/dashv2

# Logger level: debug | info | warn | error
LOG_LEVEL=info
