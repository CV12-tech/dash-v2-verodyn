// trader-gold: Asien-Breakout für XAU/USD als TradingView-Indikator.
// Dieselben Regeln wie .claude/skills/trader-gold/signals.py:
//   1. Asien-Spanne = Hoch/Tief 00:00-08:00 (Europe/Berlin)
//   2. nur wenn die Spanne 0,25-1,0 Tages-ATR(14) breit ist
//   3. Trend: Kauf nur wenn letzter Tagesschluss > SMA20, Verkauf nur darunter
//   4. Signal: erster 5-Min-Schluss 08:00-16:00 über Asien-Hoch / unter Asien-Tief
//   5. Stopp = Mitte der Spanne, Ziel = 1,5 R, flat um 21:00
// Der Wirtschaftskalender kann in Pine nicht gelesen werden: Termine selbst
// beachten (oder die Push-Pipeline aus signals.py parallel laufen lassen).
//
// Einrichten: 5-Minuten-Chart OANDA:XAUUSD, Indikator hinzufügen, dann
// Alarm erstellen -> Bedingung "Gold Asien-Breakout" -> "Any alert() function call".
//@version=5
indicator("Gold Asien-Breakout", shorttitle="Gold Breakout", overlay=true, max_labels_count=500)

tz        = input.string("Europe/Berlin", "Zeitzone")
asiaSess  = input.session("0000-0800", "Asien-Session")
entrySess = input.session("0800-1600", "Einstiegsfenster")
flatHour  = input.int(21, "Glattstellen um (Stunde)", minval=0, maxval=23)
minW      = input.float(0.25, "Min. Spanne (x ATR)", step=0.05)
maxW      = input.float(1.0, "Max. Spanne (x ATR)", step=0.05)
targetR   = input.float(1.5, "Ziel (R)", step=0.25)
useTrend  = input.bool(true, "Trendfilter (Tagesschluss vs. SMA20)")

// Values of the last COMPLETED daily bar; [1] + lookahead_on does not repaint.
[dAtr, dSma, dClose] = request.security(syminfo.tickerid, "D",
     [ta.sma(ta.tr(true), 14)[1], ta.sma(close, 20)[1], close[1]],
     lookahead=barmerge.lookahead_on)

inAsia  = not na(time(timeframe.period, asiaSess, tz))
inEntry = not na(time(timeframe.period, entrySess, tz))
asiaStart = inAsia and not inAsia[1]

var float aHi    = na
var float aLo    = na
var int   side   = 0      // 1 Kauf, -1 Verkauf, 0 keiner
var bool  done   = false  // heute schon ein Signal (offen oder erledigt)
var bool  inTrade   = false
var float ent    = na
var float stp    = na
var float tgt    = na
var int   entBar = na

fmt(x) => str.tostring(x, format.mintick)

if asiaStart
    aHi := high
    aLo := low
    side := 0
    done := false
    inTrade := false
    ent := na
    stp := na
    tgt := na
else if inAsia
    aHi := math.max(aHi, high)
    aLo := math.min(aLo, low)

width   = aHi - aLo
wAtr    = width / dAtr
rangeOk = not na(wAtr) and wAtr >= minW and wAtr <= maxW
trendUp = dClose > dSma
canBuy  = not useTrend or trendUp
canSell = not useTrend or not trendUp

// Entry on a confirmed 5-minute close outside the Asia range.
if barstate.isconfirmed and inEntry and not inAsia and not done and rangeOk
    if close > aHi and canBuy
        side := 1
    else if close < aLo and canSell
        side := -1
    if side != 0
        done := true
        inTrade := true
        ent := close
        stp := math.round_to_mintick((aHi + aLo) / 2)
        risk = math.abs(ent - stp)
        tgt := math.round_to_mintick(ent + side * targetR * risk)
        entBar := bar_index
        word = side == 1 ? "KAUFEN" : "VERKAUFEN"
        label.new(bar_index, side == 1 ? low : high, word + "\n" + fmt(ent),
             style=side == 1 ? label.style_label_up : label.style_label_down,
             color=side == 1 ? color.green : color.red, textcolor=color.white, size=size.small)
        alert("Gold " + word + "-Signal (" + syminfo.ticker + ")\nEinstieg " + fmt(ent) + " | Stopp " + fmt(stp) +
             " | Ziel " + fmt(tgt) + " | Risiko " + fmt(risk) + "/oz\nAsien " + fmt(aLo) + "-" + fmt(aHi) +
             ", Trend " + (trendUp ? "auf" : "ab") + ". Wirtschaftskalender pruefen!", alert.freq_once_per_bar_close)

// Outcome: target, stop (a bar touching both counts as stop) or flat time.
if barstate.isconfirmed and inTrade and bar_index > entBar
    hitStop = side == 1 ? low <= stp : high >= stp
    hitTgt  = side == 1 ? high >= tgt : low <= tgt
    isFlat  = hour(time, tz) >= flatHour or inAsia
    string result = na
    if hitStop
        result := "STOPP ausgeloest"
    else if hitTgt
        result := "ZIEL erreicht"
    else if isFlat
        result := "Feierabend: glattstellen"
    if not na(result)
        inTrade := false
        r = hitStop ? -1.0 : hitTgt ? targetR : side * (close - ent) / math.abs(ent - stp)
        label.new(bar_index, side == 1 ? high : low, result + "\n" + str.tostring(r, "#.##") + "R",
             style=side == 1 ? label.style_label_down : label.style_label_up,
             color=hitTgt ? color.teal : hitStop ? color.maroon : color.gray, textcolor=color.white, size=size.tiny)
        alert("Gold " + (side == 1 ? "Kauf" : "Verkauf") + ": " + result + " bei " + fmt(close) +
             ", Ergebnis " + str.tostring(r, "#.##") + "R (Einstieg " + fmt(ent) + ")", alert.freq_once_per_bar_close)

// Chart: Asia range, and entry/stop/target while a trade is open.
showRange = not inAsia and not na(aHi) and hour(time, tz) < flatHour
plot(showRange ? aHi : na, "Asien-Hoch", color=color.new(color.orange, 0), style=plot.style_linebr)
plot(showRange ? aLo : na, "Asien-Tief", color=color.new(color.orange, 0), style=plot.style_linebr)
plot(inTrade ? ent : na, "Einstieg", color=color.blue, style=plot.style_linebr)
plot(inTrade ? stp : na, "Stopp", color=color.red, style=plot.style_linebr)
plot(inTrade ? tgt : na, "Ziel", color=color.green, style=plot.style_linebr)
bgcolor(inAsia ? color.new(color.orange, 92) : na, title="Asien-Session")

// Status box.
var table box = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 75))
if barstate.islast
    status = inTrade ? (side == 1 ? "KAUF offen" : "VERKAUF offen") : done ? "heute erledigt" :
         inAsia ? "Asien läuft" : not rangeOk ? "kein Trade (Spanne)" : inEntry ? "wartet auf Ausbruch" : "außerhalb Fenster"
    table.cell(box, 0, 0, "Status", text_color=color.white)
    table.cell(box, 1, 0, status, text_color=color.yellow)
    table.cell(box, 0, 1, "Spanne", text_color=color.white)
    table.cell(box, 1, 1, na(wAtr) ? "-" : str.tostring(wAtr, "#.##") + " ATR", text_color=color.white)
    table.cell(box, 0, 2, "Trend", text_color=color.white)
    table.cell(box, 1, 2, trendUp ? "auf (nur Kauf)" : "ab (nur Verkauf)", text_color=trendUp ? color.lime : color.red)
    table.cell(box, 0, 3, "ATR(14) Tag", text_color=color.white)
    table.cell(box, 1, 3, fmt(dAtr), text_color=color.white)
